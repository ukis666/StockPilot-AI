# Optional: otherwise a random secret is persisted in instance/secret-key (Docker: /data/secret-key).
SECRET_KEY=
# Normal local operation preserves upstream inventory.db. Docker sets /data/inventory.db.
# DATABASE_URL=sqlite:////absolute/path/to/inventory.db
# MODEL_DIR=/absolute/path/to/model-artifacts
# UPLOAD_FOLDER=/absolute/path/to/uploads
# Optional local llama.cpp. For Docker use http://llm:8080 and enable --profile llm.
LLM_URL=
APP_PORT=5000
COOKIE_SECURE=0
